# ── xAI (Grok) 인증 ─────────────────────────
# 방법 1) X OAuth 로그인 (권장): python -m xp grok-login
#         토큰은 ~/.naverblog/grok_oauth.json 에 자동 저장됩니다.
# 방법 2) xAI API 키 (OAuth 대안): 실제 키는 .env 에만 넣으세요.
# XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxx

# 모델 설정 (선택, 기본값이 있음)
# 텍스트: grok-4.5 (기본, 최신) / grok-4.3 / grok-4.20-non-reasoning
# XAI_CHAT_MODEL=grok-4.5
# 이미지: grok-imagine-image (기본) / grok-imagine-image-quality (고품질)
# XAI_IMAGE_MODEL=grok-imagine-image
# 장문 칼럼용 리서치 md 입력 폴더 (기본: input)
# XP_INPUT_DIR=input

# ── Google Drive ─────────────────────────────
GOOGLE_SA_KEY_PATH=path/to/service_account.json
GDRIVE_FOLDER_ID=your_folder_id_here

# ── X (Twitter) API — Phase 2 (트윗 게시용) ──
# Grok용 X OAuth(구독 로그인)와는 별개인 X 계정 OAuth 1.0a 토큰입니다.
# developer.x.com 에서 앱 생성 (권한: Read and write) 후 입력하세요.
# X_CONSUMER_KEY=
# X_CONSUMER_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=